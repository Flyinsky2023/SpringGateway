# Spring Gateway 环境变量配置示例
# 将此文件复制为 .env 文件，并根据您的环境进行配置

# ================ JWT 配置 ================
# JWT 密钥 - 生产环境必须设置强密码
# 建议使用至少32字节的随机字符串
JWT_SECRET=your_strong_jwt_secret_key_here_at_least_32_bytes

# JWT 令牌过期时间（秒）
# JWT_EXPIRATION=86400  # 24小时

# ================ Redis 配置 ================
# Redis 连接信息
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # 生产环境建议设置密码
# REDIS_DATABASE=0

# ================ 数据库配置 ================
# 数据库连接信息（如果使用数据库）
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=spring_gateway
# DB_USERNAME=root
# DB_PASSWORD=your_database_password

# ================ 应用配置 ================
# 应用运行端口
# SERVER_PORT=8080

# 应用运行环境
# SPRING_PROFILES_ACTIVE=dev  # dev, test, prod

# ================ CORS 配置 ================
# 允许的前端域名（多个用逗号分隔）
# ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ================ 日志配置 ================
# 日志级别
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_YOUR_PACKAGE=DEBUG

# ================ 安全配置 ================
# 是否启用安全功能
# SECURITY_ENABLED=true

# ================ 其他配置 ================
# 应用名称
# APP_NAME=SpringGateway

# 版本信息
# APP_VERSION=1.0.0

# 注意：
# 1. 生产环境的所有敏感信息（密码、密钥等）必须通过环境变量或密钥管理服务配置
# 2. 不要将 .env 文件提交到版本控制系统
# 3. 开发环境可以使用 .env.local 文件覆盖配置